        "resource": "draft",
        "subject": "Your Sunpath solar enquiry - next steps",
        "message": "={{ $(\"Qualify Lead\").item.json.output.draft_email }}\n\nWe have pencilled in a site assessment for {{ DateTime.fromISO($(\"Book Site Assessment\").item.json.start.dateTime).setLocale(\"en\").toFormat(\"cccc d LLLL, h:mm a\") }}. Reply to confirm.\n\nSunpath Solar & Electrical",
        "options": {
          "sendTo": "={{ $('Normalize Enquiry').item.json.email }}"
        }
      }
    },
