    {
      "id": "2d0f5250-ad05-5753-aeee-7bc125c0c9ca",
      "name": "Qualify Lead",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        464,
        320
      ],
      "parameters": {
        "promptType": "define",
        "text": "=New solar enquiry:\nName: {{ $json.fullName }}\nEmail: {{ $json.email }}\nPhone: {{ $json.phone }}\nSuburb: {{ $json.suburb }}\nProperty type: {{ $json.propertyType }}\nQuarterly bill: {{ $json.billBand }}\nMessage: {{ $json.message }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You qualify inbound enquiries for Sunpath Solar & Electrical, a residential and commercial solar installer in Western Sydney, Australia. Grade each enquiry as \"hot\", \"warm\" or \"cold\".\n\nRules:\n- hot: owns a freestanding house or commercial premises, quarterly bill of $600 or more, and clear intent to get solar. Ready for a site assessment.\n- warm: interested but lower usage, a townhouse or duplex, or a vague message with no timeframe. Worth a call, lower priority.\n- cold: an apartment (no roof to install on), outside the service area, off topic or spam. Do not book an assessment.\n\nEstimate estimated_system_size_kw from the bill band and property type, using common Australian residential sizes (6.6, 10, 13.2) and larger for commercial. Estimate estimated_annual_savings_aud from the bill band. Write situation_summary in one short sentence.\n\nWrite draft_email: a short, warm reply from the Sunpath team. Thank them, confirm Sunpath can help with their situation, and say a consultant will be in touch to arrange the site assessment. Do not invent a specific time, a price, or a rebate amount. Under 90 words.\n\nReturn only the structured fields."
        }
      }
    },
    {
      "id": "b3f00d5f-a339-5076-a57f-f789f4d53385",
      "name": "GPT-5.4 mini",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        320,
        544
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5.4-mini",
          "cachedResultName": "gpt-5.4-mini"
        },
        "responsesApiEnabled": false,
        "options": {}
      }
    },
    {
      "id": "5cdc48da-e5f4-567c-ba70-657abe3eb4ff",
      "name": "Lead Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        528,
        544
      ],
      "parameters": {
        "jsonSchemaExample": "{ \"grade\": \"hot\", \"estimated_system_size_kw\": 6.6, \"estimated_annual_savings_aud\": 1450, \"situation_summary\": \"Freestanding house in Penrith, bill over $1,000 a quarter, wants to move before summer\", \"summary\": \"Strong fit. Owns the roof, high usage, ready to move. Book a site assessment.\", \"reasoning\": \"Freestanding house, highest bill band, clear intent.\", \"draft_email\": \"Hi Dave, thanks for getting in touch with Sunpath. A bill that size on a freestanding roof is exactly the situation we work with. One of our consultants will be in touch to arrange a site assessment. Sunpath Solar & Electrical\" }"
      }
    },
    {
      "id": "e5f7717a-8688-52b5-880d-fe95d2cf40db",
      "name": "Route by Grade",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        768,
        320
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.grade }}",
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  },
                  {
                    "leftValue": "={{ $json.output.grade }}",
                    "rightValue": "warm",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "or"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 1
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.output.grade }}",
                    "rightValue": "cold",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "Needs Review"
        }
      }
    },
    {
      "id": "475e04d1-0c7a-5acc-bd94-cf9fad7ed72a",
      "name": "Create Solar Lead",
      "type": "n8n-nodes-base.zohoCrm",
      "typeVersion": 1,
      "position": [
        1024,
        128
      ],
      "parameters": {
        "resource": "lead",
        "Company": "Sunpath Solar Prospect",
        "lastName": "={{ $('Normalize Enquiry').item.json.fullName }}",
        "additionalFields": {
          "Description": "=Grade: {{ $(\"Qualify Lead\").item.json.output.grade }}\nEst. system size: {{ $(\"Qualify Lead\").item.json.output.estimated_system_size_kw }} kW\nEst. annual saving: ${{ $(\"Qualify Lead\").item.json.output.estimated_annual_savings_aud }}\nProperty: {{ $(\"Normalize Enquiry\").item.json.propertyType }} in {{ $(\"Normalize Enquiry\").item.json.suburb }}\nQuarterly bill: {{ $(\"Normalize Enquiry\").item.json.billBand }}\n\n{{ $(\"Qualify Lead\").item.json.output.summary }}",
          "Email": "={{ $('Normalize Enquiry').item.json.email }}",
          "Lead_Source": "Website Enquiry",
          "Lead_Status": "Qualified",
          "Phone": "={{ $('Normalize Enquiry').item.json.phone }}"
        }
      }
    },
    {
      "id": "9a40e900-8865-5cb8-9e5e-12e22554b459",
      "name": "Book Site Assessment",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        1280,
        128
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": "YOUR_CALENDAR_ID",
          "cachedResultName": "YOUR_CALENDAR_ID"
        },
        "start": "={{ $now.plus(1, \"day\").set({ hour: 10, minute: 0, second: 0, millisecond: 0 }).toISO() }}",
        "end": "={{ $now.plus(1, \"day\").set({ hour: 10, minute: 30, second: 0, millisecond: 0 }).toISO() }}",
        "additionalFields": {
          "description": "=Grade: {{ $(\"Qualify Lead\").item.json.output.grade }} | Est. {{ $(\"Qualify Lead\").item.json.output.estimated_system_size_kw }} kW, ${{ $(\"Qualify Lead\").item.json.output.estimated_annual_savings_aud }} a year\nProperty: {{ $(\"Normalize Enquiry\").item.json.propertyType }}\nQuarterly bill: {{ $(\"Normalize Enquiry\").item.json.billBand }}\n\n{{ $(\"Qualify Lead\").item.json.output.summary }}",
          "summary": "=Site assessment - {{ $(\"Normalize Enquiry\").item.json.fullName }} ({{ $(\"Normalize Enquiry\").item.json.suburb }})"
        }
      }
    },
    {
      "id": "ee53c2e6-6c44-5b55-ba85-354c507e3562",
      "name": "Draft Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1552,
        128
      ],
