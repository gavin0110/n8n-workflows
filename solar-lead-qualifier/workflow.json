{
  "name": "Sunpath Solar Lead Qualifier",
  "nodes": [
    {
      "id": "7bae6f96-b776-57d4-974f-76f79e075ebc",
      "name": "Website Enquiry",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        320
      ],
      "parameters": {
        "formTitle": "Get a free solar assessment - Sunpath Solar & Electrical",
        "formDescription": "Tell us about your property and your power bill. One of our consultants will get back to you.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Full Name",
              "requiredField": true
            },
            {
              "fieldLabel": "Email",
              "fieldType": "email",
              "requiredField": true
            },
            {
              "fieldLabel": "Phone"
            },
            {
              "fieldLabel": "Suburb",
              "requiredField": true
            },
            {
              "fieldLabel": "Property Type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Freestanding house"
                  },
                  {
                    "option": "Townhouse or duplex"
                  },
                  {
                    "option": "Apartment"
                  },
                  {
                    "option": "Commercial premises"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Quarterly Electricity Bill",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Under $300"
                  },
                  {
                    "option": "$300 to $600"
                  },
                  {
                    "option": "$600 to $1,000"
                  },
                  {
                    "option": "Over $1,000"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Your message",
              "fieldType": "textarea"
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Request my assessment"
        }
      }
    },
    {
      "id": "59474edb-3942-5d10-9cdf-14191e70d856",
      "name": "Normalize Enquiry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        320
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "fullName",
              "value": "={{ $json[\"Full Name\"] }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "email",
              "value": "={{ $json[\"Email\"] }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "phone",
              "value": "={{ $json[\"Phone\"] }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "suburb",
              "value": "={{ $json[\"Suburb\"] }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "propertyType",
              "value": "={{ $json[\"Property Type\"] }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "billBand",
              "value": "={{ $json[\"Quarterly Electricity Bill\"] }}",
              "type": "string"
            },
            {
              "id": "a7",
              "name": "message",
              "value": "={{ $json[\"Your message\"] }}",
