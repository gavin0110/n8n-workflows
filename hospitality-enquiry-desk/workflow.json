          "__rl": true,
          "mode": "id",
          "value": "YOUR_SLACK_CHANNEL_ID",
          "cachedResultName": "redlands-ops"
        },
        "text": "=*{{ $(\"Read It And Decide\").item.json.output.venue }} needs a manager*\n\n*Guest:* {{ $(\"Read It And Decide\").item.json.output.guest_name }}\n*What happened:* {{ $(\"Read It And Decide\").item.json.output.summary }}\n\nA ticket is open in HubSpot. The reply is drafted and waiting for approval.",
        "otherOptions": {
