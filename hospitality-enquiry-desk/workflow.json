    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Register"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Received": "={{ $now.setZone(\"Australia/Sydney\").toFormat(\"yyyy-MM-dd HH:mm\") }}",
            "Venue": "={{ $json.output.venue }}",
            "From": "={{ $json.output.guest_name }}",
            "Type": "={{ $json.output.category }}",
            "Summary": "={{ $json.output.summary }}",
            "Sentiment": "={{ $json.output.sentiment }}",
            "Decision": "={{ $json.output.is_guest ? ($json.output.sentiment === \"Negative\" ? \"Ticket opened, manager alerted\" : \"Guest record updated, reply drafted\") : \"Logged only, no CRM record\" }}",
            "Reason": "={{ $json.output.reason }}",
            "Confidence": "={{ $json.output.confidence }}"
          },
          "schema": [
            {
