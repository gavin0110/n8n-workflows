    {
      "id": "f8375321-4519-5ced-8b9e-312cd9663c1f",
      "name": "Refresh The Card Headlines",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1660,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Work Out Cover').all().map(i => i.json);\nconst n = rows.length;\nconst reorder = rows.filter(r => r.needs_alert);\nconst top = rows.find(r => r.status === 'Picking up' || r.read === 'Taking off');\nconst rev = rows.length ? rows[0].revenue_30d_total : 0;\nconst units = rows.reduce((s, r) => s + r.sold_30d, 0);\nconst money = v => '$' + Math.round(v).toLocaleString('en-US');\nconst short = p => String(p).split(' (')[0];\nlet h1 = reorder.length + ' of ' + n + ' SKUs need a reorder';\nif (reorder.length) h1 += ' · ' + reorder.map(r => short(r.product)).join(', ');\nelse if (top) h1 += ' · ' + short(top.product) + ' picking up';\nlet h2 = money(rev) + ' · ' + units + ' units';\nif (top) h2 += ' · ' + short(top.product) + ' at ' + top.pace + ' its usual pace';\nreturn [\n  { json: { n: 1, headline: h1 } },\n  { json: { n: 2, headline: h2 } }\n];"
      }
    },
