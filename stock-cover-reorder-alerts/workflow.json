    {
      "id": "3b73187c-7a71-542b-ac80-7fa94996cc00",
      "name": "Work Out Cover",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const DAYS = 30;\nconst now = new Date();\nconst cutoff30 = new Date(now.getTime() - DAYS * 86400000);\nconst cutoff7 = new Date(now.getTime() - 7 * 86400000);\nconst oresp = $('Read 30 Days Of Orders').first().json || {};\nconst orders = ((oresp.data || {}).orders || {}).nodes || [];\nconst presp = $('Read Products And Stock').first().json || {};\nconst variants = ((presp.data || {}).productVariants || {}).nodes || [];\nconst incoming = $('Read Incoming Deliveries').all().map(i => i.json);\nconst alerts = $input.all().map(i => i.json).filter(a => a && a.SKU);\n\nconst bySku = {};\nfor (const v of variants) {\n  if (!v.sku) continue;\n  bySku[v.sku] = { sku: v.sku, product: String((v.product || {}).title || ''), on_hand: Number(v.inventoryQuantity || 0), price: Number(v.price || 0), sold_30d: 0, sold_7d: 0, revenue_30d: 0 };\n}\nlet orders30 = 0;\nlet revenue30 = 0;\nfor (const o of orders) {\n  if (o.cancelledAt) continue;\n  const t = new Date(o.processedAt);\n  if (isNaN(t.getTime()) || t < cutoff30) continue;\n  orders30 += 1;\n  revenue30 += Number((((o.currentTotalPriceSet || {}).shopMoney || {}).amount) || 0);\n  for (const li of (((o.lineItems || {}).nodes) || [])) {\n    const r = bySku[li.sku];\n    if (!r) continue;\n    const q = Number(li.quantity || 0);\n    const unit = Number((((li.originalUnitPriceSet || {}).shopMoney || {}).amount) || r.price);\n    r.sold_30d += q;\n    r.revenue_30d += q * unit;\n    if (t >= cutoff7) r.sold_7d += q;\n  }\n}\nconst inc = {};\nfor (const row of incoming) {\n  const sku = String(row.SKU || '').trim();\n  if (!sku) continue;\n  inc[sku] = { units: Number(row.Units || 0), due: Number(row['Due in (days)'] || 0) };\n}\nconst today = now.toISOString().slice(0, 10);\nconst alertedToday = new Set(alerts.filter(a => String(a.Date || '').slice(0, 10) === today).map(a => String(a.SKU)));\n\nconst out = [];\nfor (const r of Object.values(bySku)) {\n  const per_day = r.sold_30d / DAYS;\n  const per_day7 = r.sold_7d / 7;\n  const cover = per_day > 0 ? r.on_hand / per_day : (r.on_hand > 0 ? 9999 : 0);\n  const d = inc[r.sku];\n  let status = 'OK';\n  let needs = false;\n  if (r.on_hand < 0) {\n    status = 'Preorder: ' + (-r.on_hand) + ' committed' + (d ? ', ' + (d.units + r.on_hand) + ' free on arrival' : ', no delivery booked');\n  } else if (d && cover < d.due) {\n    const gap = Math.round(d.due - cover); status = 'REORDER: runs out ' + gap + (gap === 1 ? ' day' : ' days') + ' before the delivery';\n    needs = true;\n  } else if (!d && cover < 21) {\n    status = 'REORDER: no delivery booked';\n    needs = true;\n  } else if (cover > 120) {\n    status = 'Slow mover';\n  } else if (per_day > 0 && per_day7 > 1.5 * per_day) {\n    status = 'Picking up';\n  } else if (d && cover - d.due < 3) {\n    status = 'OK, tight';\n  }\n  const pace = per_day > 0 ? per_day7 / per_day : 0;\n  let read = 'Steady';\n  if (r.on_hand < 0) read = 'Preorder demand';\n  else if (cover > 120) read = 'Slow, ' + r.on_hand + ' on the shelf';\n  else if (pace >= 1.5) read = 'Taking off';\n  else if (pace <= 0.6 && r.sold_30d >= 10) read = 'Fading';\n  out.push({ json: {\n    sku: r.sku, product: r.product, on_hand: r.on_hand,\n    sold_30d: r.sold_30d, sold_7d: r.sold_7d,\n    per_day: Number(per_day.toFixed(1)), per_day_7d: Number(per_day7.toFixed(1)),\n    days_of_cover: cover >= 9999 ? '' : Math.round(cover),\n    cover_at_recent_pace: per_day7 > 0 ? Math.round(r.on_hand / per_day7) : '',\n    incoming: d ? d.units : '', due_in: d ? d.due + ' days' : '', due_days: d ? d.due : '',\n    status, needs_alert: needs, alerted_today: alertedToday.has(r.sku),\n    pace: pace ? pace.toFixed(1) + 'x' : '', revenue_30d: Math.round(r.revenue_30d), read,\n    orders_30d: orders30, revenue_30d_total: Math.round(revenue30)\n  } });\n}\nout.sort((a, b) => b.json.sold_30d - a.json.sold_30d);\nreturn out;"
      }
    },
