    {
      "id": "847905ea-7adb-54c7-a207-2f21972586cd",
      "name": "Refresh The KPIs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $('Work Out Cover').all().map(i => i.json);\nconst n = rows.length;\nconst reorder = rows.filter(r => r.needs_alert).length;\nconst slow = rows.filter(r => r.status === 'Slow mover').length;\nconst pick = rows.filter(r => r.status === 'Picking up').length;\nconst orders = rows.length ? rows[0].orders_30d : 0;\nconst rev = rows.length ? rows[0].revenue_30d_total : 0;\nconst units = rows.reduce((s, r) => s + r.sold_30d, 0);\nconst money = v => '$' + Math.round(v).toLocaleString('en-US');\nconst hot = rows.filter(r => r.needs_alert).map(r => r.product.split(' (')[0]);\nreturn [\n  { json: { label: 'Revenue, last 30 days', value: money(rev), sub: 'Shopify · ' + orders + ' orders', trend: 'up', at_risk: '' } },\n  { json: { label: 'Orders, last 30 days', value: String(orders), sub: (orders / 30).toFixed(1) + ' a day · ' + (units / 30).toFixed(1) + ' units a day', trend: 'up', at_risk: '' } },\n  { json: { label: 'SKUs needing a reorder', value: reorder + ' of ' + n, sub: reorder ? hot.join(', ') : slow + ' slow movers · ' + pick + ' picking up', trend: reorder ? 'up' : 'flat', at_risk: reorder ? 'TRUE' : '' } }\n];"
      }
    },
