    {
      "id": "b9153f68-dc6f-5aab-85b6-9a3d02eaa936",
      "name": "Write The Alert",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=Product: {{ $json.product }} (SKU {{ $json.sku }})\nOn hand now: {{ $json.on_hand }} units\nSold in the last 30 days: {{ $json.sold_30d }} units, {{ $json.per_day }} a day\nSold in the last 7 days: {{ $json.sold_7d }} units, {{ $json.per_day_7d }} a day\nDays of cover at the 30 day pace: {{ $json.days_of_cover }}\nDays of cover at the last 7 days pace: {{ $json.cover_at_recent_pace }}\nNext delivery: {{ $json.incoming }} units, due in {{ $json.due_days }} days",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You write stock alerts for the owner of Kettleford Fitness, a family-owned fitness equipment brand. You are given the numbers for one product. Use ONLY those numbers, never add a figure that is not in them. Write three short lines in plain English and nothing else. Line 1: what is happening with this product, in one sentence. Line 2: how many days before the delivery it runs out, at the 30 day pace and at the last 7 days pace. Line 3: one move the owner could make today, starting with the word Suggested. No greeting, no sign-off, no bullet characters, no asterisks, no markdown, no em dashes. Under 75 words in total."
            }
          ]
        },
        "batching": {}
      }
    },
